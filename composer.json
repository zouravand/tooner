{
  "name": "tedon/tooner",
  "description": "PHP TOON (Token-Oriented Object Notation) encoder/decoder",
  "type": "library",
  "keywords": ["toon", "encoding", "serialization", "laravel"],
  "license": "MIT",
  "authors": [
    {
      "name": "Pouya Zouravand",
      "email": "pouya.zuravand@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "illuminate/support": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Tedon\\Tooner\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tedon\\Tooner\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Tedon\\Tooner\\ToonerServiceProvider"
      ],
      "aliases": {
        "Tooner": "Tedon\\Tooner\\Facades\\Tooner"
      }
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}